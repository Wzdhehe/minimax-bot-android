<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Native broker verification" android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Verification-only probe. This service is not in the product APK. -->
        <service android:name="io.github.ccch1mneyyy.dsh_app.probe.IsolationBoundaryProbeService"
            android:exported="false" android:isolatedProcess="true" />
        <service android:name="io.github.ccch1mneyyy.dsh_app.isolation.AgentBrokerService"
            android:exported="false" />
        <service android:name="io.github.ccch1mneyyy.dsh_app.isolation.AgentIsolationService"
            android:exported="false" android:isolatedProcess="true" />
        <!-- The production declaration of the private backup worker, unchanged:
             its own isolated UID, its own process, not exported. It never
             shares the Agent process and receives no shell, code or Key. -->
        <service
            android:name="io.github.ccch1mneyyy.dsh_app.isolation.SqliteBackupService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":sqlite_backup" />
    </application>
</manifest>
